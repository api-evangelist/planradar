                  "type": "any",
                  "value": "<string>",
                  "key": "project_id",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ticket_uuid",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-PlanRadar-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"attributes\": {\n      \"video\": \"<string>\",\n      \"base64\": \"<string>\",\n      \"video-content-type\": \"<string>\",\n      \"caption\": \"<string>\",\n      \"uuid\": \"<string>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
