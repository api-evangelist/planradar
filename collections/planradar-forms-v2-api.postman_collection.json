{
  "item": [
    {
      "id": "14398dca-4229-4701-b252-b3bf4a2f0c33",
      "name": "Forms V2",
      "description": {
        "content": "Get your PlanRadar forms",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "f4b08c72-0641-41f1-a973-5bb84d6b30a3",
          "name": "Returns all ticket types of a specific project",
          "request": {
            "name": "Returns all ticket types of a specific project",
            "description": {
              "content": "This API returns all forms aka ticket_types of a specific project or all the projects the user is involved in.</br>",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                ":customer_id",
                "projects",
                ":project_id",
                "ticket_types",
                "ticket_type_project"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "last_sync_date",
                  "value": "<string>",
                  "description": "is a Unix Timestamp. If it is set, only ticket types that were created after that timestamp will be returned"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "sets the number of pages for the returned ticket types"
                },
                {
                  "disabled": false,
                  "key": "pagesize",
                  "value": "<integer>",
                  "description": "sets the number of ticket types that should be returned per page<br/>Maximum is 500, default is 100"
                },
                {
                  "disabled": false,
                  "key": "apply_form_display_permission",
                  "value": "<boolean>",
                  "description": "(KFT-338) when <code>true</code>, filters bound ticket_type_projects to forms the caller's role can see (<code>capabilities.visible_to</code> match or unrestricted). Watchers bypass. Results are cached per flag value. Default <code>false</code>."
                },
                {
                  "disabled": false,
                  "key": "apply_form_edit_permission",
                  "value": "<boolean>",
                  "description": "(KFT-338) when <code>true</code>, filters bound ticket_type_projects to forms the caller's role can edit (<code>capabilities.editable_by</code> match or unrestricted). Independent of the display flag. Default <code>false</code>."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "customer_id",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "project_id",
                  "description": "(Required) if you want to load the ticket types of all projects set the project_id to 0"
                }
              ]
            },
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-PlanRadar-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
          },
          "response": [
            {
              "id": "ea55d832-4525-4690-8bcf-3fa0bfae8962",
              "name": "Unsupported Accept Header",
              "originalRequest": {
