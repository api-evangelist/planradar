          "name": "Retrieve all roles for a customer",
          "request": {
            "name": "Retrieve all roles for a customer",
            "description": {
              "content": "Returns all roles defined for the customer account. Supports pagination, search, sorting, and sync filtering. Each role includes a count-assigned-users attribute representing the number of distinct users assigned to that role across projects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                ":customer_id",
                "roles"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number for pagination"
                },
                {
                  "disabled": false,
                  "key": "pagesize",
                  "value": "<integer>",
                  "description": "Number of roles per page (default: 100, max: 500)"
                },
                {
                  "disabled": false,
                  "key": "last_sync_date",
                  "value": "<string>",
                  "description": "Unix timestamp. Only roles updated after this time are returned"
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Filter roles by name (case-insensitive)"
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort field. Prefix with '-' for descending. e.g. 'name', '-created-on', 'is-admin-role'"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "100000",
                  "key": "customer_id",
                  "description": "(Required) "
