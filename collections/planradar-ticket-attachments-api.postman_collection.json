            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"attributes\": {\n      \"uuid\": \"<string>\",\n      \"attachment\": \"<string>\",\n      \"attachment-name\": \"<string>\",\n      \"caption\": \"<string>\"\n    }\n  }\n}",
