        {
          "id": "90346e56-b227-4577-ab80-d006fb9181bb",
          "name": "Create New Document",
          "request": {
            "name": "Create New Document",
            "description": {
              "content": "API to upload new documents.<br /><br />  <b>Supported Types:</b>  [PDF, Excel, Word, DWG, DXF]<br />\n        This API accepts both base64 and multipart data.<br />\n          <b>Base64 Uploads</b>\n          Set `is_base64` to `true`, add the base64 encoded document to the `document` field, add the uploaded file name to `filename`\n          <br /><b>Multipart Uploads</b>\n          Set `is_base64` to `false`, set the value of the `document` field to be the multipart data",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                ":customer_id",
                "projects",
                ":project_id",
                "documents",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "customer_id",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "project_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-PlanRadar-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"attributes\": {\n      \"title\": \"<string>\",\n      \"component-id\": \"<integer>\",\n      \"is-base64\": \"<boolean>\",\n      \"async\": \"<boolean>\",\n      \"document\": \"<string>\",\n      \"uuid\": \"<string>\",\n      \"ticket-id\": \"<string>\",\n      \"filename\": \"<string>\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
