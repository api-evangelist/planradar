          "name": "Returns all project ticket types of a specific project",
          "request": {
            "name": "Returns all project ticket types of a specific project",
            "description": {
              "content": "This API returns all the ticket types that are assigned to a specific project based on its id",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                ":customer_id",
                "projects",
                ":project_id",
                "ticket_types_project"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "last_sync_date",
                  "value": "<string>",
                  "description": "is a Unix Timestamp. If it is set, only project ticket types that were created after that timestamp will be returned"
                },
                {
                  "disabled": false,
                  "key": "apply_form_display_permission",
                  "value": "<boolean>",
                  "description": "When true, only forms visible to the caller's role are returned (role-based form visibility, KFT-519). Watchers bypass the filter."
                },
                {
                  "disabled": false,
                  "key": "apply_form_edit_permission",
                  "value": "<boolean>",
                  "description": "When true, only forms editable by the caller's role are returned. Combine with apply_form_display_permission to intersect."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "customer_id",
