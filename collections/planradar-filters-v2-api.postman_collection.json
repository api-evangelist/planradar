        {
          "id": "53016d99-d1d1-4383-b10b-d11ee45b9e66",
          "name": "List available filterable fields for a given type",
          "request": {
            "name": "List available filterable fields for a given type",
            "description": {
              "content": "Returns all available filter fields for a given entity type (e.g., tickets, dms, approval-requests). Each field includes its ID, name, type, predicates, and display options.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                ":customer_id",
                "projects",
                ":project_id",
                "filters",
                "filterable_fields"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Type of entity to get filterable fields for"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
