          "name": "Returns all lists of a specific project",
          "request": {
            "name": "Returns all lists of a specific project",
            "description": {
              "content": "This API returns all lists that are attached to the ticket types that are used by a specific project based on its id.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                ":customer_id",
                "projects",
                ":project_id",
                "ticket_types",
                "lists",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "last_sync_date",
                  "value": "<string>",
                  "description": "is a Unix Timestamp. If it is set, only lists that were created after that timestamp will be returned"
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": " sets the number of pages for the returned lists"
                },
                {
                  "disabled": false,
                  "key": "pagesize",
                  "value": "<integer>",
                  "description": " sets the number of lists that should be returned per page<br/>Maximum is 500, default is 100"
                },
