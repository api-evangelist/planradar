        {
          "id": "acf69f69-3b60-4b9f-a9a1-a1684670528d",
          "name": "Returns a paginated list of projects",
          "request": {
            "name": "Returns a paginated list of projects",
            "description": {
              "content": "Returns projects the current user has access to, scoped by their customer permission. Users with the report_templates permission (and without limited_projects) receive all account projects so templates can be assigned across the account.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v2",
                ":customer_id",
                "projects"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "Page number for pagination."
                },
                {
                  "disabled": false,
                  "key": "pagesize",
                  "value": "<integer>",
                  "description": "Number of projects per page."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort expression. Defaults to project name ascending."
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Filters projects by name."
                },
                {
                  "disabled": false,
                  "key": "include_archived",
                  "value": "<boolean>",
                  "description": "When present, archived projects are included in the result."
                },
                {
                  "disabled": false,
                  "key": "load_all",
                  "value": "<boolean>",
                  "description": "When present, returns all matching projects without pagination."
                },
                {
                  "disabled": false,
                  "key": "load_template",
                  "value": "<boolean>",
                  "description": "When true, scopes the result to projects relevant for the templates flow."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "100000",
                  "key": "customer_id",
                  "description": "(Required) "
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-PlanRadar-API-Key"
                },
                {
                  "key": "value",
                  "value": "{{apiKey}}"
                },
                {
                  "key": "in",
                  "value": "header"
                }
              ]
            }
